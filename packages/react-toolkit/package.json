{
  "name": "@dawg-codes/react-toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible, themeable React components and design tokens from DawgStack.",
  "keywords": [
    "react",
    "components",
    "design-system",
    "design-tokens",
    "ui",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawg-codes/DawgStack.git",
    "directory": "packages/react-toolkit"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "button": [
        "./dist/button.d.cts"
      ],
      "spinner": [
        "./dist/spinner.d.cts"
      ],
      "visually-hidden": [
        "./dist/visually-hidden.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./button": {
      "import": {
        "types": "./dist/button.d.ts",
        "default": "./dist/button.js"
      },
      "require": {
        "types": "./dist/button.d.cts",
        "default": "./dist/button.cjs"
      }
    },
    "./spinner": {
      "import": {
        "types": "./dist/spinner.d.ts",
        "default": "./dist/spinner.js"
      },
      "require": {
        "types": "./dist/spinner.d.cts",
        "default": "./dist/spinner.cjs"
      }
    },
    "./visually-hidden": {
      "import": {
        "types": "./dist/visually-hidden.d.ts",
        "default": "./dist/visually-hidden.js"
      },
      "require": {
        "types": "./dist/visually-hidden.d.cts",
        "default": "./dist/visually-hidden.cjs"
      }
    },
    "./core.css": "./dist/core.css",
    "./styles.css": "./dist/styles.css",
    "./css/*.css": "./dist/css/*.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-css.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint --strict && attw --pack . --exclude-entrypoints ./core.css ./styles.css \"./css/*.css\"",
    "sync-exports": "node scripts/sync-exports.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.4",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
