{
  "name": "dawgstack",
  "private": true,
  "description": "DawgStack monorepo: reusable React components, design tokens and developer utilities.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm --filter @dawg-codes/react-toolkit build",
    "test": "pnpm --filter @dawg-codes/react-toolkit test",
    "typecheck": "pnpm --filter @dawg-codes/react-toolkit typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "leak-guard": "node tooling/leak-guard.mjs",
    "check:package": "pnpm --filter @dawg-codes/react-toolkit check:package",
    "check": "pnpm leak-guard && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm check:package && pnpm --filter playground --filter \"./templates/*\" build",
    "playground": "pnpm build && pnpm --filter playground dev",
    "playground:build": "pnpm build && pnpm --filter playground build",
    "starter": "pnpm build && pnpm --filter dawgstack-starter dev",
    "sign-in": "pnpm build && pnpm --filter dawgstack-sign-in dev",
    "admin-dashboard": "pnpm build && pnpm --filter dawgstack-admin-dashboard dev",
    "user-management": "pnpm build && pnpm --filter dawgstack-user-management dev"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
